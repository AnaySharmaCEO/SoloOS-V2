# ==============================================================================
# SoloOS Client Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and provide your environment-specific credentials.
# NOTE: Never commit .env or any live secrets into version control.
# ==============================================================================

# Managed Backend Service Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-client-anon-key

# Client Payment Gateway Configuration (Public / Publishable Keys Only)
VITE_BILLING_PROVIDER=razorpay
VITE_RAZORPAY_KEY_ID=your_public_gateway_key
